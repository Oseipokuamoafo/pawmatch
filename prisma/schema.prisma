generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // PostGIS extension — required for future GIST radius indexes.
  // Disabled until Postgres is upgraded to v17+ (Homebrew's postgis 3.6
  // is built for PG17/18; not loadable into PG16). When you upgrade:
  //   1. Uncomment the line below
  //   2. Run `npx prisma db push` OR `psql -d pawmatch -f prisma/migrations/add_postgis.sql`
  // The Haversine helper in src/lib/geo.ts works without it.
  // extensions = [postgis]
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  OWNER
  BREEDER
  VET
  ADMIN
}

enum VetApplicationStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum AIScreenStatus {
  PENDING
  MATCH
  MISMATCH
  NO_DATA
  ERROR
}

enum Species {
  DOG
  CAT
}

enum Sex {
  MALE
  FEMALE
}

enum HealthRecordType {
  VACCINE
  DNA
  VET_VISIT
  CERTIFICATE
}

enum TraitSource {
  SELF_REPORTED
  DNA_VERIFIED
}

enum MatchStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum ReportStatus {
  OPEN
  REVIEWED
  RESOLVED
  DISMISSED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  emailVerified       DateTime?
  name                String?
  image               String?
  passwordHash        String?
  role                Role                 @default(OWNER)
  isVerified          Boolean              @default(false)
  verificationBadge   Boolean              @default(false)
  locationLat         Float?
  locationLng         Float?

  // ── Vet program (slice 1 of vet network) ─────────────────────────
  vetApplicationStatus VetApplicationStatus @default(NONE)
  vetLicenseNumber     String?
  vetLicenseState      String?
  vetPracticeName      String?
  vetPracticeAddress   String?
  vetPracticePhone     String?
  vetApprovedAt        DateTime?
  vetApprovedById      String?

  // ── AI auto-screen (slice 4 of vet network) ──────────────────────
  /// Verdict from the Claude-API agent that cross-references the
  /// applicant's license against the state veterinary medical board.
  /// MATCH + high confidence auto-promotes the user; everything else
  /// routes to the admin queue with the AI's evidence attached.
  aiScreenStatus       AIScreenStatus?
  aiScreenConfidence   Float?
  aiScreenReason       String?
  /// JSON array of { url, title, quote } evidence rows.
  aiScreenEvidence     Json?
  aiScreenedAt         DateTime?
  aiAutoApprovedAt     DateTime?

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  accounts            Account[]
  sessions            Session[]
  pets                Pet[]
  sentMatches         Match[]              @relation("SentMatches")
  receivedMatches     Match[]              @relation("ReceivedMatches")
  messages            Message[]
  reports             Report[]             @relation("ReporterReports")
  verificationRequest VerificationRequest?
  vetCoSignatures     PetHealth[]          @relation("VetCoSignatures")
  vetCosignRequests   PetHealth[]          @relation("VetCosignRequests")

  @@index([email])
  @@index([vetApplicationStatus])
}

// ─── NextAuth required models ─────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Pet {
  id              String         @id @default(cuid())
  name            String
  species         Species
  breed           String
  dateOfBirth     DateTime
  sex             Sex
  color           String?
  weight          Float?
  bio             String?
  isActive        Boolean        @default(true)
  livePhotoUrl    String?
  ownerId         String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  owner           User           @relation(fields: [ownerId], references: [id])
  photos          PetPhoto[]
  healthRecords   PetHealth[]
  traits          PetTrait[]
  breedingGoals   BreedingGoal[]
  heatCycles      HeatCycle[]
  sentMatches     Match[]        @relation("PetAMatches")
  receivedMatches Match[]        @relation("PetBMatches")
  breedingChat    BreedingChat?

  @@index([ownerId])
  @@index([species])
  @@index([breed])
}

model HeatCycle {
  id                 String   @id @default(cuid())
  petId              String
  /// Day the heat (proestrus) started. Required.
  startDate          DateTime
  /// Day the heat ended (estrus → diestrus transition). Null while ongoing.
  endDate            DateTime?
  /// Optional explicit fertile-window dates. When null the engine
  /// estimates day 9-13 of the cycle (canine norm).
  peakFertilityStart DateTime?
  peakFertilityEnd   DateTime?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  pet                Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId])
  @@index([startDate])
}

model PetPhoto {
  id        String   @id @default(cuid())
  petId     String
  url       String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId])
}

model PetHealth {
  id              String           @id @default(cuid())
  petId           String
  type            HealthRecordType
  title           String
  fileUrl         String?
  isVerified      Boolean          @default(false)
  /// Legacy free-text marker ("self" / vet name string). Kept for back-compat.
  verifiedBy      String?
  verifiedAt      DateTime?
  /// FK to the vet (User where role=VET) who co-signed this record.
  /// Owner self-reports flip to verified once a vet signs.
  verifiedByVetId String?
  /// Vet the owner has asked to co-sign. Set by the owner; cleared when
  /// the vet signs (verifiedByVetId takes over) or declines.
  requestedVetId  String?
  requestedAt     DateTime?
  notes           String?
  recordDate      DateTime

  pet             Pet              @relation(fields: [petId], references: [id], onDelete: Cascade)
  verifiedByVet   User?            @relation("VetCoSignatures", fields: [verifiedByVetId], references: [id])
  requestedVet    User?            @relation("VetCosignRequests", fields: [requestedVetId], references: [id])

  @@index([petId])
  @@index([verifiedByVetId])
  @@index([requestedVetId])
}

model PetTrait {
  id         String      @id @default(cuid())
  petId      String
  traitName  String
  traitValue String
  source     TraitSource @default(SELF_REPORTED)

  pet        Pet         @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId])
}

model BreedingGoal {
  id              String   @id @default(cuid())
  petId           String
  desiredTraits   Json
  preferredBreeds String[]
  maxCOI          Float?
  notes           String?

  pet             Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId])
}

model Match {
  id            String      @id @default(cuid())
  petAId        String
  petBId        String
  score         Float
  /// JSON of the 5 component scores so the UI can render a breakdown.
  /// { traits, health, diversity, proximity, preferences }
  breakdown     Json?
  status        MatchStatus @default(PENDING)
  flags         String[]
  initiatedById String
  receivedById  String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  petA          Pet         @relation("PetAMatches", fields: [petAId], references: [id])
  petB          Pet         @relation("PetBMatches", fields: [petBId], references: [id])
  initiatedBy   User        @relation("SentMatches", fields: [initiatedById], references: [id])
  receivedBy    User        @relation("ReceivedMatches", fields: [receivedById], references: [id])
  messages      Message[]
  contract      Contract?

  @@index([petAId])
  @@index([petBId])
  @@index([initiatedById])
  @@index([receivedById])
  @@index([status])
}

model Message {
  id               String   @id @default(cuid())
  matchId          String
  senderId         String
  encryptedContent String
  iv               String
  createdAt        DateTime @default(now())
  isRead           Boolean  @default(false)

  match            Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sender           User     @relation(fields: [senderId], references: [id])

  @@index([matchId])
  @@index([senderId])
}

model Contract {
  id           String   @id @default(cuid())
  matchId      String   @unique
  templateType String
  content      String
  signedByA    Boolean  @default(false)
  signedByB    Boolean  @default(false)
  pdfUrl       String?
  createdAt    DateTime @default(now())

  match        Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

model Breed {
  id                   String   @id @default(cuid())
  name                 String
  slug                 String?  @unique
  species              Species
  group                String?
  averageCOI           Float?
  commonRecessiveGenes String[]
  minBreedingAgeMale   Int?
  minBreedingAgeFemale Int?
  description          String?

  // Phase 3 additions
  heroImageUrl         String?
  temperament          String[]
  lifespanMinYears     Int?
  lifespanMaxYears     Int?
  weightKgMin          Float?
  weightKgMax          Float?
  // Phase 4: real pedigree intelligence (Wright's path coefficients,
  // founder distribution, etc.). For now this is a JSON stub so the
  // model is ready when the data arrives.
  pedigreePlaceholder  Json?

  @@unique([name, species])
  @@index([species])
  @@index([slug])
}

model Report {
  id           String       @id @default(cuid())
  reporterId   String
  targetUserId String?
  targetPetId  String?
  reason       String
  description  String?
  status       ReportStatus @default(OPEN)
  createdAt    DateTime     @default(now())

  reporter     User         @relation("ReporterReports", fields: [reporterId], references: [id])

  @@index([reporterId])
  @@index([targetUserId])
  @@index([targetPetId])
  @@index([status])
}

model VerificationRequest {
  id                 String             @id @default(cuid())
  userId             String             @unique
  documents          String[]
  programDescription String
  status             VerificationStatus @default(PENDING)
  reviewedBy         String?
  reviewedAt         DateTime?
  notes              String?
  createdAt          DateTime           @default(now())

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// One Claude-API-backed breeding-assistant thread per pet. The pet's
/// health + DNA + breed profile is rebuilt into the system prompt on
/// every request (cacheable prefix), so we only persist user/assistant
/// turns here. Cascading delete with the pet.
model BreedingChat {
  id            String                @id @default(cuid())
  petId         String                @unique
  /// Total turns sent so far — used to enforce per-thread limits.
  turnCount     Int                   @default(0)
  /// Best-effort token totals (input + output) for cost tracking.
  inputTokens   Int                   @default(0)
  outputTokens  Int                   @default(0)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  pet           Pet                   @relation(fields: [petId], references: [id], onDelete: Cascade)
  messages      BreedingChatMessage[]

  @@index([petId])
}

model BreedingChatMessage {
  id        String       @id @default(cuid())
  chatId    String
  /// "user" or "assistant" — matches Anthropic Messages API roles.
  role      String
  content   String       @db.Text
  createdAt DateTime     @default(now())

  chat      BreedingChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@index([createdAt])
}
